{
  "ConnectionStrings": {
    "DefaultConnection": "SET_VIA_USER_SECRETS"
  },
  "JwtSettings": {
    "SecretKey": "SET_VIA_USER_SECRETS",
    "Issuer": "HarfiAPI",
    "Audience": "HarfiClient",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "SET_VIA_USER_SECRETS",
    "SenderName": "Harfi Platform",
    "AppPassword": "SET_VIA_USER_SECRETS"
  },
  "AllowedOrigins": [
    "http://localhost:4200",
    "https://harfi.app"
  ],
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY",
    "Model": "gpt-4o",
    "EmbeddingModel": "text-embedding-3-small"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-1.5-flash"
  },
  "ChromaDB": {
    "BaseUrl": "http://localhost:8000",
    "CollectionName": "harfi_knowledge_base"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}